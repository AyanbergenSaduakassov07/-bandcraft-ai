{
  "name": "BandCraft: refresh template index",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [1],
              "triggerAtHour": 3
            }
          ]
        }
      },
      "id": "5b0e7c1e-1f0a-4d7e-9a51-2f6b8c3d4e01",
      "name": "Every Monday 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/AyanbergenSaduakassov07/-bandcraft-ai/actions/workflows/template-index.yml/dispatches",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"ref\": \"main\",\n  \"inputs\": { \"count\": \"60\" }\n}",
        "options": {}
      },
      "id": "8c2d4f6a-3b1e-4c9d-8e7f-1a2b3c4d5e02",
      "name": "Dispatch template-index workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "notes": "GitHub runs the refresh (generate, embed, append to pgvector); calibrate refits when it succeeds. Credential: a fine-grained token with Actions: read and write on this repo only.",
      "notesInFlow": true
    }
  ],
  "connections": {
    "Every Monday 03:00": {
      "main": [[{ "node": "Dispatch template-index workflow", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
