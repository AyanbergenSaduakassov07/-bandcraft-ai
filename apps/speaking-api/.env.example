# apps/speaking-api. See docs/adr/0005-speaking-providers-and-hosted-pronunciation.md
GEMINI_API_KEY=
# Shared with apps/web (SPEAKING_API_KEY there); only the web server may call this API.
SPEAKING_API_KEY=
# The private Hugging Face Space running apps/pronunciation-endpoint, and a token that can read it.
PRONUNCIATION_URL=https://<user>-<space>.hf.space
PRONUNCIATION_TOKEN=
# Optional overrides
SPEAKING_LIVE_MODEL=gemini-3.8-live
SPEAKING_VOICE=Charon
SPEAKING_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash
